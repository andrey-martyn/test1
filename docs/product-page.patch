+ .lavka-product-delivery__header>h2{margin:0;font-size:18px;line-height:24px;font-weight:500}
+ .lavka-product-delivery__close{flex:none;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:#f2f5ee;color:#63745e;font-size:28px;line-height:40px}
+ .lavka-product-delivery__body{max-height:calc(85vh - 70px);max-height:calc(85dvh - 70px);overflow-y:auto;overscroll-behavior:contain;padding:16px 16px calc(24px + env(safe-area-inset-bottom));font-size:14px;line-height:1.55;overflow-wrap:anywhere}
+ .lavka-product-delivery__body p,.lavka-product-delivery__body ul,.lavka-product-delivery__body ol{margin:0 0 14px}
+ .lavka-product-delivery__body h2,.lavka-product-delivery__body h3,.lavka-product-delivery__body h4{margin:18px 0 8px;font-size:16px;line-height:22px;font-weight:500}
+ .lavka-product-delivery__body :first-child{margin-top:0}
+ .lavka-product-delivery__body a{color:#3d6420;text-decoration:underline}
+ .lavka-product-delivery__body table{display:block;max-width:100%;overflow:auto}
+ .lavka-product-delivery__body td,.lavka-product-delivery__body th{padding:5px}
+ .lavka-product-delivery__retry{display:block;min-height:44px;margin:14px 0 0;padding:8px 14px;border:0;border-radius:9px;background:#4f7f28;color:#fff;font-family:inherit;font-size:14px;font-weight:500}
+}
+@media(max-width:359px){
+ .lavka-product-buy-line,.lavka-product-dock{grid-template-columns:minmax(0,1fr) 88px 48px;gap:8px}
+ .lavka-product-mobile .product-page__cart>.qty-switch,.lavka-product-dock__quantity{width:88px}
+ .lavka-product-mobile .product-page__cart .lavka-product-qty-button,.lavka-product-dock__quantity>button{flex-basis:28px;width:28px}
+ .lavka-product-mobile .product-page__add-to-cart,.lavka-product-dock__buy{padding:10px;gap:0}
+ .lavka-product-mobile .product-page__add-to-cart>span{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
+ .lavka-product-dock__buy{font-size:0}
+ .lavka-product-nav>button{padding:8px 6px;font-size:11px}
+ .lavka-product-dock--no-quantity{grid-template-columns:minmax(0,1fr) 48px}
