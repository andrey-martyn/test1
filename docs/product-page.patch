+ .lavka-product-mobile .product-page__wishlist-btn,.lavka-product-mobile .product-page__compare-btn{right:10px;width:44px;height:44px;border:1px solid #ffffffb3;border-radius:50%;background:#ffffffbf;color:#63745e;backdrop-filter:blur(4px);z-index:10}
+ .lavka-product-mobile .product-page__wishlist-btn{top:10px}
+ .lavka-product-mobile .product-page__wishlist-btn i{font-size:20px}
+ .lavka-product-mobile .product-page__compare-btn{top:60px}
+ .lavka-product-mobile .product-block>br{display:none}
