+<td><input class="form-control" name="tags[{{ code }}][label_ru]" maxlength="40" value="{{ tag.label_ru|e('html_attr') }}" required></td>
+<td><input class="form-control" name="tags[{{ code }}][label_uk]" maxlength="40" value="{{ tag.label_uk|e('html_attr') }}" required></td>
+<td><input type="color" name="tags[{{ code }}][background]" value="{{ tag.background }}"></td>
