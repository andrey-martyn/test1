+++ b/catalog/view/theme/unishop2/stylesheet/lavka-mobile-cards.css
@@ -0,0 +1,116 @@
+/* Source stylesheet. No generated CSS or template editor overrides. */
+.lavka-pack-caption, .lavka-select-weights { display: none; }
+@media (max-width: 519px) {
+    #content > .products-block { display: flex; flex-wrap: wrap; align-items: flex-start; }
+    #content > .products-block > .product-layout {
+        width: 50% !important; padding: 0 5px !important; float: none !important; clear: none !important;
+    }
+    #content > .products-block > [data-lavka-fallback] { width: 100% !important; }
+    #content > .products-block > [data-lavka-fallback] .product-thumb__option.option {
+        display: block !important; height: auto !important;
+    }
+    #content .lavka-mobile-card, .uni-module .lavka-mobile-card {
+        display: grid; grid-template-columns: minmax(0, 1fr) 36px; grid-template-rows: auto auto auto auto;
+        position: relative; padding: 8px; margin: 0 0 10px; min-width: 0; height: auto !important;
+        border: 1px solid #dedede; border-radius: 12px; background: #fff; box-shadow: 0 2px 6px #00000005;
+    }
+    .lavka-mobile-card .product-thumb__caption,
+    .lavka-mobile-card .product-thumb__row,
+    .lavka-mobile-card .product-thumb__cart { display: contents !important; }
+    .lavka-mobile-card .product-thumb__image {
+        grid-area: 1 / 1 / 2 / 3; min-width: 0; width: 100%; aspect-ratio: 1; margin: 0; padding: 0;
+        overflow: hidden; border: 0; border-radius: 8px;
+    }
+    .lavka-mobile-card .product-thumb__image > a,
+    .lavka-mobile-card .product-thumb__image img { display: block; width: 100%; height: 100%; }
+    .lavka-mobile-card .product-thumb__image img { object-fit: contain; }
+    .lavka-mobile-card .product-thumb__name {
+        grid-area: 2 / 1 / 3 / 3; height: auto !important; min-height: 0 !important;
+        margin: 7px 0 6px; padding: 0; color: #252a2c; font-size: 14px; line-height: 18px; font-weight: 500;
+        white-space: normal; overflow-wrap: anywhere;
+    }
+    .lavka-mobile-card .product-thumb__option.option {
+        display: block !important; grid-area: 1 / 1 / 2 / 3; align-self: end; z-index: 9;
+        min-width: 0; min-height: 0; height: auto !important; width: auto;
+        padding: 5px; margin: 0; pointer-events: none; border: 0;
+    }
+    .lavka-mobile-card .lavka-pack-group,
+    .lavka-mobile-card .lavka-select-weights {
+        display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin: 0; padding: 0;
+    }
+    .lavka-mobile-card .lavka-pack-group > .option__group-name,
+    .lavka-mobile-card .lavka-native-select { display: none !important; }
+    .lavka-mobile-card .lavka-pack-group .option__item {
+        position: relative; width: 32px; height: 32px; margin: 0; pointer-events: auto;
+    }
+    .lavka-mobile-card .lavka-pack-group input[type="radio"] {
+        display: block !important; position: absolute; inset: 0; z-index: 1; width: 32px; height: 32px;
+        margin: 0; opacity: 0; cursor: pointer;
+    }
+    .lavka-mobile-card .lavka-pack-group .option__name,
+    .lavka-mobile-card .lavka-select-weight {
+        display: flex; flex-direction: column; align-items: center; justify-content: center;
+        flex: 0 0 32px; width: 32px; height: 32px; padding: 0; margin: 0; border: 1px solid #ffffff8c;
+        border-radius: 50%; background: rgba(255,255,255,.4); backdrop-filter: blur(4px);
+        box-shadow: 0 1px 4px #00000024; color: #253020; font-size: 0; line-height: 1.05;
+        text-shadow: 0 1px 0 #ffffffa6; pointer-events: auto; cursor: pointer;
+    }
+    .lavka-mobile-card [data-lavka-number]::before { content: attr(data-lavka-number); font-size: 11px; font-weight: 500; }
+    .lavka-mobile-card [data-lavka-unit]::after { content: attr(data-lavka-unit); font-size: 9px; margin-top: 1px; }
+    .lavka-mobile-card .lavka-pack-group input:checked + .option__name,
+    .lavka-mobile-card .lavka-select-weight[aria-pressed="true"] {
+        background: rgba(61,100,29,.82); color: #fff; border-color: #ffffffc7; text-shadow: none;
+        box-shadow: inset 0 2px 4px #203a1870, 0 0 0 1px #375920; transform: translateY(1px);
+    }
+    .lavka-mobile-card .lavka-pack-group input:disabled + .option__name,
+    .lavka-mobile-card .lavka-select-weight:disabled { opacity: .45; cursor: default; }
